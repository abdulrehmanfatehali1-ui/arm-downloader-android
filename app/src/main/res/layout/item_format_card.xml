<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/format_card_bg"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Quality Badge -->
        <TextView
            android:id="@+id/tvQualityBadge"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="1080p"
            android:textColor="#8b5cf6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Labels -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvQualityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full HD Video"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQualitySize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="~ 45 MB"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Selected Indicator -->
        <ImageView
            android:id="@+id/ivSelected"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="invisible"
            android:contentDescription="Selected" />

    </LinearLayout>
</LinearLayout>
